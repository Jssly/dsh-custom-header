{
  "name": "dsh-profile-selector",
  "version": "1.0.0",
  "description": "双模式 .deepseek.yaml 提示词档案选择器：开发用动态插件（dshy-1），发布用静态插件（dsh-profile-selector）。",
  "license": "ISC",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "features.md",
    "internals.md",
    "deployment.md"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "jest": {
    "verbose": false,
    "collectCoverage": true,
    "globals": {},
    "setupFilesAfterEnv": [
      "<rootDir>/jest/setup/setupFileAfterEnv.js"
    ],
    "testMatch": [
      "<rootDir>/**/*.test.js"
    ],
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js"
    ],
    "testTimeout": 120000
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "slots",
        "connection"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jest": "^30.4.2"
  },
  "dependencies": {
    "react": "^19.2.8",
    "yaml": "^2.9.1"
  }
}
